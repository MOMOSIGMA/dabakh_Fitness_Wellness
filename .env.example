# ---- Coach IA (Groq) ----
# Cle : https://console.groq.com/keys
GROQ_API_KEY=

# Modele Groq. Groq retire regulierement ses modeles : si le coach cesse de
# repondre, lister les modeles valides et changer cette valeur.
#   curl.exe -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
GROQ_MODEL=openai/gpt-oss-120b

# ---- Avis (Upstash Redis) ----
# Cree une base sur https://console.upstash.com puis copie les deux valeurs
# de l'onglet "REST API". Sans elles, le site fonctionne mais la section
# Avis reste vide et le formulaire renvoie une erreur explicite.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Jeton de moderation des avis (chaine longue et aleatoire, a garder secrete).
# Utilise par /api/reviews/moderate pour publier ou supprimer un avis.
REVIEWS_ADMIN_TOKEN=

# ---- Divers ----
NEXT_PUBLIC_SITE_URL=https://dabakh-fitness-wellness.vercel.app
